<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_discount_list" model="ir.ui.view">
        <field name="name">subscription.discount.list</field>
        <field name="model">subscription.discount</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="discount_type"/>
                <field name="value"/>
                <field name="active"/>
                <field name="usage_count"/>
                <field name="maximum_usage_count"/>
            </list>
        </field>
    </record>
    <record id="view_subscription_discount_form" model="ir.ui.view">
        <field name="name">subscription.discount.form</field>
        <field name="model">subscription.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="discount_type"/>
                        <field name="value"/>
                        <field name="currency_id"/>
                        <field name="scope"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="minimum_purchase_amount"/>
                        <field name="minimum_quantity"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="maximum_usage_count"/>
                        <field name="usage_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="plan_ids" widget="many2many_tags"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_subscription_discount" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">subscription.discount</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_subscription_discount" name="Discounts"
              parent="sale.sale_menu_root" action="action_subscription_discount"
              groups="group_subscription_admin"/>
</odoo>
