<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="billing_frequency"/>
                <field name="recurring_price"/>
                <field name="minimum_quantity"/>
                <field name="available_from"/>
                <field name="available_until"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="recurring_price"/>
                            <field name="currency_id"/>
                            <field name="billing_frequency"/>
                            <field name="minimum_quantity"/>
                        </group>
                        <group>
                            <field name="available_from"/>
                            <field name="available_until"/>
                            <field name="automatic_closure"/>
                            <field name="allow_early_closure"/>
                            <field name="allow_pause"/>
                            <field name="allow_renewal"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="product_id"/>
                                    <field name="minimum_quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_subscription_plan_root" name="Subscription Plans"
              parent="sale.sale_menu_root" action="action_subscription_plan"
              groups="group_subscription_staff"/>
</odoo>
