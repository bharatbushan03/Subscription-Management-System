<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_subscription_fields" model="ir.ui.view">
        <field name="name">sale.order.subscription.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="subscription_plan_id"/>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="quotation_expired" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_template_subscription_fields" model="ir.ui.view">
        <field name="name">sale.order.template.subscription.fields</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number_of_days']" position="after">
                <field name="applicable_plan_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
