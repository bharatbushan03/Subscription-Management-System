<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Same domains as the portal rules in base, sale, and account.
        Group rules are OR-combined, so these must not be wider than the
        portal rules. Customers imply portal, and these rules still apply
        if that implication is removed later.
        Subscription-model rules are added with that model.
    -->
    <record id="rule_partner_customer" model="ir.rule">
        <field name="name">Subscription customer partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', 'child_of', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_user_customer" model="ir.rule">
        <field name="name">Subscription customer users</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[('commercial_partner_id', '=', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_sale_order_customer" model="ir.rule">
        <field name="name">Subscription customer quotations</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_invoice_customer" model="ir.rule">
        <field name="name">Subscription customer invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('state', 'not in', ('cancel', 'draft')), ('move_type', 'in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')), ('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_subscription_plan_admin" model="ir.rule">
        <field name="name">Subscription administrators see all plans</field>
        <field name="model_id" ref="model_subscription_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_admin'))]"/>
    </record>

    <record id="rule_subscription_plan_available" model="ir.rule">
        <field name="name">Available subscription plans</field>
        <field name="model_id" ref="model_subscription_plan"/>
        <field name="domain_force">[('available_for_selection', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_staff')), (4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_subscription_plan_line_admin" model="ir.rule">
        <field name="name">Subscription administrators see all plan lines</field>
        <field name="model_id" ref="model_subscription_plan_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_admin'))]"/>
    </record>

    <record id="rule_subscription_plan_line_available" model="ir.rule">
        <field name="name">Lines of available subscription plans</field>
        <field name="model_id" ref="model_subscription_plan_line"/>
        <field name="domain_force">[
            ('active', '=', True),
            ('plan_id.available_for_selection', '=', True)
        ]</field>
        <field name="groups" eval="[(4, ref('group_subscription_staff')), (4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_subscription_admin" model="ir.rule">
        <field name="name">Subscription administrators see all subscriptions</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_admin'))]"/>
    </record>

    <record id="rule_subscription_staff" model="ir.rule">
        <field name="name">Staff see all subscriptions</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_staff'))]"/>
    </record>

    <record id="rule_subscription_customer" model="ir.rule">
        <field name="name">Customers see their subscriptions</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>

    <record id="rule_subscription_line_admin" model="ir.rule">
        <field name="name">Subscription administrators see all lines</field>
        <field name="model_id" ref="model_subscription_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_admin'))]"/>
    </record>

    <record id="rule_subscription_line_staff" model="ir.rule">
        <field name="name">Staff see all subscription lines</field>
        <field name="model_id" ref="model_subscription_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_staff'))]"/>
    </record>

    <record id="rule_subscription_line_customer" model="ir.rule">
        <field name="name">Customers see their subscription lines</field>
        <field name="model_id" ref="model_subscription_line"/>
        <field name="domain_force">[('subscription_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_subscription_customer'))]"/>
    </record>
</odoo>
