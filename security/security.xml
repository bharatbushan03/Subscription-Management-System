<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_subscription">
        <field name="name">Subscription</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_subscription_customer" model="res.groups">
        <field name="name">Customer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal customers. They see only their own commercial partner.</field>
    </record>

    <record id="group_subscription_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_subscription"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('account.group_account_invoice')),
        ]"/>
        <field name="comment">Internal staff. Quotations, subscriptions, invoices, and payments. No user administration and no tax or discount configuration.</field>
    </record>

    <record id="group_subscription_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_subscription"/>
        <field name="implied_ids" eval="[
            (4, ref('group_subscription_staff')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('product.group_product_manager')),
            (4, ref('base.group_erp_manager')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full subscription access, products, taxes, discounts, and staff accounts. Does not grant Settings.</field>
    </record>
</odoo>
